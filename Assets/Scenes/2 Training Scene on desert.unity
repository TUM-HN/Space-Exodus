  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Because movement can be slow, teleportation is allowed in the game. The
    teleportation controller is on the right joystick roller. Pushing the joystick
    forward will display a parabolic arc. If the arc is green, teleportation is available;
    if it is red, it is not.


    Advanced Tip: After enabling teleportation by
    pushing the right joystick roller forward, do not release it. You can control
    the body orientation after teleportation by moving in any direction.


    Now
    try to teleport to the front door! You will find next statoin inside the basement.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: f675742eaf9c20a4f909d78ee7a14fed, type: 2}
  m_sharedMaterial: {fileID: 4687939059374929122, guid: f675742eaf9c20a4f909d78ee7a14fed,
    type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
